<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>TeoStackXt</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <os-version min="14.0"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <choices-outline><line choice="default"><line choice="com.teostack.xt"/></line></choices-outline>
    <choice id="default"/>
    <choice id="com.teostack.xt" visible="false"><pkg-ref id="com.teostack.xt"/></choice>
    <pkg-ref id="com.teostack.xt" version="@VERSION@" onConclusion="none">TeoStackXt-component.pkg</pkg-ref>
</installer-gui-script>
